dontaudit untrusted_app ashmem_device:chr_file open;
dontaudit fsck mnt_vendor_file:dir search;
dontaudit fsck block_device:blk_file { read write open };
dontaudit rild cache_file:dir { getattr search };
dontaudit rild rm_vendor_radio_vendor_data_file:dir { getattr search };
dontaudit {
  hal_audio_default
  hal_fingerprint_default
  hal_sensors_default
  rild
  vendor_hal_neuralnetworks_default
} default_prop:file { read open getattr map };
dontaudit hal_sensors_default system_prop:file { read open getattr map };
dontaudit hal_audio_default system_prop:file { read open getattr map };
dontaudit rild system_prop:file { read open getattr map };
dontaudit rild vendor_pd_locater_dbg_prop:file { read open getattr map };
dontaudit {
  hal_sensors_default
  rild
  vendor_hal_imsrtp
  vendor_ims
  vendor_netmgrd
  vendor_sensors_qti
} vendor_diag_device:chr_file { read write open ioctl };
dontaudit vendor_qtidataservices_app default_prop:file { read open getattr map };
dontaudit vendor_rmt_storage { default_prop system_prop }:file { read open getattr map };
dontaudit hal_camera_default { default_prop system_prop }:file { read open getattr map };
dontaudit init self:capability sys_ptrace;
