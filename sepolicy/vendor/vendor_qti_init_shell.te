allow vendor_qti_init_shell sysfs_wakeup:file setattr;
allow vendor_qti_init_shell ctl_stop_prop:property_service set;

get_prop(vendor_qti_init_shell, oppo_debug_prop)

allow vendor_qti_init_shell sysfs:file write;

allow vendor_qti_init_shell proc_page_cluster:file rw_file_perms;
allow vendor_qti_init_shell proc_swaps:file r_file_perms;
allow vendor_qti_init_shell proc_extra_free_kbytes:file rw_file_perms;
allow vendor_qti_init_shell vendor_sysfs_kgsl:file rw_file_perms;


# To set powerhal init property
set_prop(vendor_qti_init_shell, vendor_power_prop)
set_prop(vendor_qti_init_shell, oppo_fingerprint_prop)
