<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
   	  xmlns:tools="http://schemas.android.com/tools"
          android:sharedUserId="android.uid.system"
          package="org.aospextended.device"
          android:versionCode="1"
          android:versionName="1" >

    <uses-permission android:name="android.permission.INJECT_EVENTS"/>
    <uses-permission android:name="android.permission.DEVICE_POWER" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.CONFIGURE_DISPLAY_BRIGHTNESS" />

    <protected-broadcast android:name="com.android.systemui.doze.pulse" />

    <uses-sdk
        android:minSdkVersion="24"
        android:targetSdkVersion="36"/>

    <application
            android:icon="@android:drawable/sym_def_app_icon"
            android:label="@string/RealmeParts"
            android:theme="@style/AppTheme"
            android:defaultToDeviceProtectedStorage="true"
            android:directBootAware="true"
            >

        <!-- stub to ensure its loaded - DO NOT REMOVE -->
        <activity android:name=".KeyHandler" />

        <activity
            android:name=".RealmePartsActivity"
            android:label="@string/RealmeParts"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
	    </activity>

        <activity-alias
            android:name=".RealmeParts"
            android:label="@string/RealmeParts"
            android:targetActivity="RealmePartsActivity"
            android:exported="true">
            <intent-filter>
                <category android:name="android.intent.category.DEFAULT" />
                <action android:name="com.android.settings.action.EXTRA_SETTINGS" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.icon"
                android:resource="@drawable/ic_realmeparts" />
            <meta-data
                android:name="com.android.settings.bg.hint"
                android:resource="@color/icon_bg_color"  />
            <meta-data
                android:name="com.android.settings.bg.argb"
                android:value="@color/icon_bg_color"/>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.system" />
            <meta-data android:name="com.android.settings.summary"
                android:resource="@string/RealmeParts_summary" />
        </activity-alias>

        <activity
            android:name=".gestures.TouchGesturesActivity"
            android:label="@string/screen_off_gestures"
            android:exported="true">
          <intent-filter>
                <action android:name="com.android.settings.action.EXTRA_SETTINGS" />
          </intent-filter>
        </activity>

        <receiver android:name=".BootReceiver"
                  android:exported="true" >
          <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <category android:name="android.intent.category.DEFAULT" />
          </intent-filter>
        </receiver>

        <service android:name=".doze.DozeService"
                 android:exported="false" />

        <service android:name=".battery.ChargeLimitService"
                 android:exported="false" />

        <service android:name=".display.AutoBrightnessService"
                 android:exported="false" />

        <service
            android:name=".display.HbmTileService"
            android:icon="@drawable/ic_hbm"
            android:label="@string/hbm_title"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".otg.OtgTileService"
            android:icon="@drawable/ic_otg"
            android:label="@string/otg_mode_title"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>


        <service
            android:name=".gestures.TouchGesturesTileService"
            android:icon="@drawable/ic_touch_gestures"
            android:label="@string/screen_off_gestures"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".display.DcDimmingTileService"
            android:icon="@drawable/ic_dc_dimming"
            android:label="@string/dc_dimming_title"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".battery.ChargeLimitTileService"
            android:icon="@drawable/ic_charge_limit"
            android:label="@string/charge_limit_enable_title"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>


        <activity
            android:name=".doze.DozeSettingsActivity"
            android:label="@string/ambient_display_title"
            android:exported="true">
            <intent-filter>
                <action android:name="org.aospextended.device.DOZE_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- SettingsLib and SettingsLibCollapsingToolbarBaseActivity each bundle an
             androidx App Startup InitializationProvider with library-specific
             authorities. The manifest merger keys providers by class name, so the
             two authorities collide. Declare one merged provider with this app's
             own authority and override the conflicting attribute; child <meta-data>
             initializers from both libraries still merge in. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="org.aospextended.device.androidx-startup"
            android:exported="false"
            tools:node="merge"
            tools:replace="android:authorities" />

    </application>

</manifest>
