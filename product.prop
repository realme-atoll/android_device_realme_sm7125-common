# Charger
ro.charger.enable_suspend=true

# Display
debug.sf.latch_unsignaled=1
debug.sf.disable_client_composition_cache=0

# LMKD
ro.config.low_ram=false
ro.lmk.log_stats=false
ro.lmk.kill_heaviest_task=true
# Was 100 (= "swap always low") which made lmkd kill apps instead of swapping, leaving
# zram unused while apps thrashed. 10 = treat swap low only under ~10% free, so the
# kernel actually fills zram before lmkd starts killing.
ro.lmk.swap_free_low_percentage=10

# LMK tuning
ro.lmk.filecache_min_kb=153600
ro.lmk.stall_limit_critical=40
ro.lmk.use_new_strategy=true
ro.lmk.enable_watermark_check=true
ro.lmk.enable_userspace_lmk=true
ro.lmk.enhance_batch_kill=false
ro.lmk.super_critical=701
ro.lmk.kill_timeout_ms=50
ro.lmk.psi_scrit_complete_stall_ms=150
ro.lmk.direct_reclaim_pressure=45
ro.lmk.reclaim_scan_threshold=0

# Incremental FS
ro.incremental.enable=1


# Fling
ro.min.fling_velocity=160
ro.max.fling_velocity=20000
ro.vendor.qti.cgroup_follow.enable=true
persist.vendor.qti.inputopts.enable=true
persist.vendor.qti.inputopts.movetouchslop=0.6
ro.qcom.adreno.qgl.ShaderStorageImageExtendedFormats=0

# Cached app compaction
persist.device_config.activity_manager.use_compaction=true
